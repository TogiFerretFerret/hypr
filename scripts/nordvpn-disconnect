#!/usr/bin/env bash
# Disconnect all Nord VPN connections and restore IPv6
nmcli -t -f NAME,TYPE connection show 2>/dev/null \
    | awk -F: 'NF>=2 && $2=="vpn" && $1~/^Nord / {print $1}' \
    | while IFS= read -r n; do
        nmcli connection down "$n" 2>/dev/null || true
        nmcli connection delete "$n" 2>/dev/null || true
    done

# Re-allow IPv6
sudo nft delete table ip6 nordvpn_leak 2>/dev/null || true

echo "done"
